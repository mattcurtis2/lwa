
# Firebase Storage Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Required on Vercel and other cloud hosts: paste the full service account JSON on one line (minify with `jq -c .`)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local dev alternative: path to service account JSON file (does not work on Vercel)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Database
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Stripe Configuration (Development - Test Keys)
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz123456789012345678901234567890
VITE_STRIPE_PUBLIC_KEY=pk_test_51234567890abcdefghijklmnopqrstuvwxyz12345678901234567890

# Stripe Configuration (Production - Live Keys)
STRIPE_SECRET_KEY_LIVE=sk_live_...
VITE_STRIPE_PUBLIC_KEY_LIVE=pk_live_...

# Session
SESSION_SECRET=generate-a-random-secret

# Optional: override default admin password in production
ADMIN_PASSWORD=

# Vercel deployment notes
# - Set all variables above in Vercel → Settings → Environment Variables for Production (and Preview if needed).
# - Enable "Expose to Build" for VITE_STRIPE_PUBLIC_KEY_LIVE (or VITE_STRIPE_PUBLIC_KEY) — Vite bakes these in at build time.
# - Use FIREBASE_SERVICE_ACCOUNT_JSON (minified single-line JSON), not FIREBASE_SERVICE_ACCOUNT_PATH.
# - Minify locally: jq -c . firebase-service-account.json
# - prebuild runs a non-fatal Firebase check; use `npm run verify-firebase` for a strict credential test.

v